# ==========================================
# Arpegia Monorepo .gitignore
# ==========================================

# Environment variables & local secrets
.env
.env*.local
.env.production
.env.staging
*.pem
*.key

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js & Frontend builds
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Audio files, uploaded datasets & models (Local runtime)
*.wav
*.mp3
*.flac
*.ogg
*.m4a
uploads/
storage/
temp/
checkpoints/
*.onnx
*.pt
*.pth

# Database & Cache files
*.sqlite3
*.db
postgres_data/
redis_data/

# OS & Editor specific files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
