# ==========================================
# Arpegia Environment Variables Configuration (Phase 1, Phase 2, Phase 3, Phase 4 & Phase 5)
# ==========================================

# Web Frontend (apps/web)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1/analyze
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_USE_MOCK=false
ARPEGIA_ASYNC_POLL_INTERVAL_MS=800

# Backend API Gateway (apps/api)
API_PORT=8000
API_HOST=0.0.0.0
DEBUG=false
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_AUDIO_EXTENSIONS=[".mp3",".wav"]
MAX_UPLOAD_SIZE_BYTES=26214400
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Audio Engine Service & DSP (services/audio-engine)
AUDIO_ENGINE_PATH=/services/audio-engine
AUDIO_ENGINE_URL=http://localhost:8001
AUDIO_ENGINE_SAMPLE_RATE=22050
AUDIO_ENGINE_HOP_LENGTH=512

# Phase 3 AI Music Intelligence: Arrangement Generator & Multi-Format Export
# 100% functional offline/deterministically without requiring paid external API keys
DEFAULT_ARRANGEMENT_STYLE=Fingerstyle
DEFAULT_ARRANGEMENT_DIFFICULTY=Intermediate
MAX_ARRANGEMENTS_PER_JOB=10
DEFAULT_EXPORT_FORMAT=midi
SUPPORTED_EXPORT_FORMATS=["midi","musicxml","ascii","pdf"]

# Phase 4 Real-Time Async Pipeline Progress Streaming
# Polling interval in ms when WebSocket connection falls back to HTTP polling
ARPEGIA_ASYNC_POLL_INTERVAL_MS=800

# Phase 5 Live Guitar Tuner & Real-Time Mic Chord Detector
TUNER_REFERENCE_A4_HZ=440.0
TUNER_IN_TUNE_TOLERANCE_CENTS=3.5
LIVE_CHORD_SAMPLE_RATE=22050
LIVE_CHORD_WS_PATH=/ws/live-chord
LIVE_CHORD_FRAME_INTERVAL_MS=100

# Database (PostgreSQL)
DATABASE_URL=postgresql://arpegia:arpegia_secret@localhost:5432/arpegia_db
POSTGRES_USER=arpegia
POSTGRES_PASSWORD=arpegia_secret
POSTGRES_DB=arpegia_db

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Object Storage (MinIO / S3)
STORAGE_BUCKET_NAME=arpegia-audio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# AI & LLM Orchestration (Optional — deterministic local music theory engine used when empty)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
