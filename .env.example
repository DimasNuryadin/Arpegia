# ==========================================
# Arpegia Environment Variables Configuration (Phase 1 & Phase 2)
# ==========================================

# Web Frontend (apps/web)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1/analyze
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_USE_MOCK=false

# Backend API Gateway (apps/api)
API_PORT=8000
API_HOST=0.0.0.0
DEBUG=false
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_AUDIO_EXTENSIONS=[".mp3",".wav"]
MAX_UPLOAD_SIZE_BYTES=26214400
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Audio Engine Service & DSP (services/audio-engine)
AUDIO_ENGINE_PATH=/services/audio-engine
AUDIO_ENGINE_URL=http://localhost:8001
AUDIO_ENGINE_SAMPLE_RATE=22050
AUDIO_ENGINE_HOP_LENGTH=512

# Database (PostgreSQL)
DATABASE_URL=postgresql://arpegia:arpegia_secret@localhost:5432/arpegia_db
POSTGRES_USER=arpegia
POSTGRES_PASSWORD=arpegia_secret
POSTGRES_DB=arpegia_db

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Object Storage (MinIO / S3)
STORAGE_BUCKET_NAME=arpegia-audio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# AI & LLM Orchestration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
